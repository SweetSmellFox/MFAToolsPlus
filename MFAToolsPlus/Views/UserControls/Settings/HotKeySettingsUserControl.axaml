<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="MFAToolsPlus.Views.UserControls.Settings.HotKeySettingsUserControl"
    x:DataType="pages:SettingsViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helper="clr-namespace:MFAToolsPlus.Helper"
    xmlns:markup="https://codewf.com"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:MFAToolsPlus.ViewModels.Pages"
    xmlns:suki="https://github.com/kikipoulet/SukiUI"
    xmlns:userControls="clr-namespace:MFAToolsPlus.Views.UserControls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="9">
        <TextBlock
            FontWeight="SemiBold"
            HorizontalAlignment="Center"
            Text="{markup:I18n {x:Static helper:LangKeys.GlobalConfigTip}}" />
        <suki:GlassCard Padding="25,8,25,8">
            <StackPanel Spacing="20">
                <DockPanel>
                    <userControls:HotKeyEditor
                        DockPanel.Dock="Right"
                        Height="40"
                        HotKey="{Binding HotKeyShowGui}"
                        IsEnabled="{Binding EnableHotKey}"
                        Margin="0,0,4,0"
                        Width="205" />
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="{markup:I18n {x:Static helper:LangKeys.HotKeyShowGui}}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
                <DockPanel>
                    <userControls:HotKeyEditor
                        DockPanel.Dock="Right"
                        Height="40"
                        HotKey="{Binding HotKeyPause}"
                        IsEnabled="{Binding EnableHotKey}"
                        Margin="0,0,4,0"
                        Width="205" />
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="{markup:I18n {x:Static helper:LangKeys.HotKeyPause}}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
                <DockPanel>
                    <userControls:HotKeyEditor
                        DockPanel.Dock="Right"
                        Height="40"
                        HotKey="{Binding HotKeyToolRoi}"
                        IsEnabled="{Binding EnableHotKey}"
                        Margin="0,0,4,0"
                        Width="205" />
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="ROI Tool"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
                <DockPanel>
                    <userControls:HotKeyEditor
                        DockPanel.Dock="Right"
                        Height="40"
                        HotKey="{Binding HotKeyToolColor}"
                        IsEnabled="{Binding EnableHotKey}"
                        Margin="0,0,4,0"
                        Width="205" />
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="Color Pick Tool"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
                <DockPanel>
                    <userControls:HotKeyEditor
                        DockPanel.Dock="Right"
                        Height="40"
                        HotKey="{Binding HotKeyToolOcr}"
                        IsEnabled="{Binding EnableHotKey}"
                        Margin="0,0,4,0"
                        Width="205" />
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="OCR Tool"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
                <DockPanel>
                    <userControls:HotKeyEditor
                        DockPanel.Dock="Right"
                        Height="40"
                        HotKey="{Binding HotKeyToolScreenshot}"
                        IsEnabled="{Binding EnableHotKey}"
                        Margin="0,0,4,0"
                        Width="205" />
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="Screenshot Tool"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
                <DockPanel>
                    <userControls:HotKeyEditor
                        DockPanel.Dock="Right"
                        Height="40"
                        HotKey="{Binding HotKeyToolSwipe}"
                        IsEnabled="{Binding EnableHotKey}"
                        Margin="0,0,4,0"
                        Width="205" />
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="Swipe Tool"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
                <DockPanel>
                    <userControls:HotKeyEditor
                        DockPanel.Dock="Right"
                        Height="40"
                        HotKey="{Binding HotKeyToolKey}"
                        IsEnabled="{Binding EnableHotKey}"
                        Margin="0,0,4,0"
                        Width="205" />
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="Key Tool"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
                <DockPanel>
                    <userControls:HotKeyEditor
                        DockPanel.Dock="Right"
                        Height="40"
                        HotKey="{Binding HotKeyToolNeuralNetworkDetect}"
                        IsEnabled="{Binding EnableHotKey}"
                        Margin="0,0,4,0"
                        Width="205" />
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="Neural Network Tool"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
                <DockPanel>
                    <userControls:HotKeyEditor
                        DockPanel.Dock="Right"
                        Height="40"
                        HotKey="{Binding HotKeyToolNone}"
                        IsEnabled="{Binding EnableHotKey}"
                        Margin="0,0,4,0"
                        Width="205" />
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="Cancel Tool"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
                <DockPanel>
                    <userControls:HotKeyEditor
                        DockPanel.Dock="Right"
                        Height="40"
                        HotKey="{Binding HotKeyScreenshotToClipboard}"
                        IsEnabled="{Binding EnableHotKey}"
                        Margin="0,0,4,0"
                        Width="205" />
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="截图复制到剪贴板"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
                <DockPanel>
                    <userControls:HotKeyEditor
                        DockPanel.Dock="Right"
                        Height="40"
                        HotKey="{Binding HotKeyQuickSaveScreenshot}"
                        IsEnabled="{Binding EnableHotKey}"
                        Margin="0,0,4,0"
                        Width="205" />
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="快速截图到文件夹"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
                <Grid Margin="0,6,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="快速截图保存目录"
                            VerticalAlignment="Center" />
                    </StackPanel>
                    <WrapPanel Grid.Column="1" HorizontalAlignment="Right" Margin="0,5,0,0" FlowDirection="RightToLeft">
                        <TextBox
                            FlowDirection="LeftToRight"
                            HorizontalAlignment="Center"
                            MinHeight="40"
                            Text="{Binding QuickScreenshotFolderPath, Mode=TwoWay}"
                            Width="215" />
                        <Button
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            FlowDirection="LeftToRight"
                            Command="{Binding BrowseQuickScreenshotFolderCommand}"
                            Height="40"
                            HorizontalAlignment="Center"
                            Margin="0,0,4,0">
                            <TextBlock
                                FontSize="14"
                                Foreground="{DynamicResource SukiPrimaryColor}"
                                Text="浏览目录" />
                        </Button>
                    </WrapPanel>
                </Grid>
            </StackPanel>

        </suki:GlassCard>
    </StackPanel>
</UserControl>
